# LLM（OpenAI 兼容接口；推荐 Kimi 平台 https://platform.moonshot.cn ）
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2-0905-preview

# 扶摇（同花顺金融数据，https://fuyao.aicubes.cn → API Key 管理页签发）
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=

# iFinD MCP（https://mcp.51ifind.com → 登录 → 个人中心 → 密钥，JWE Token）
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-stock-mcp
IFIND_AUTH_TOKEN=

# 无 Key 时：true=使用 fixtures 回放演示数据；false=显式报"数据源不可用"
ALLOW_FIXTURE_FALLBACK=true

# 停止规则 / 预算
MAX_STEPS=30
TOKEN_BUDGET=200000
TOOL_TIMEOUT_SECONDS=10
# iFinD 自然语言查询较慢（实测 6-9s），单独放宽
IFIND_TOOL_TIMEOUT_SECONDS=20

# Langfuse（可选，不填则后端自行累计成本）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 存储
SQLITE_PATH=./data/xbuddy.db
